NODE_ENV=development
PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/edupilot
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_ORIGIN=http://localhost:3000
COOKIE_NAME=edupilot_session
# Used only by the one-time create-admin bootstrap command; never commit real values.
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_INSTITUTION_NAME=
INITIAL_INSTITUTION_CODE=
